{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/assets/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/media/:path*"
    },
    {
      "source": "/music/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/music/:path*"
    },
    {
      "source": "/footage/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/footage/:path*"
    },
    {
      "source": "/models3d/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/models3d/:path*"
    },
    {
      "source": "/renders/:path*",
      "destination": "https://comparative-periodically-alerts-drove.trycloudflare.com/renders/:path*"
    }
  ]
}
