{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/assets/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/media/:path*"
    },
    {
      "source": "/music/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/music/:path*"
    },
    {
      "source": "/footage/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/footage/:path*"
    },
    {
      "source": "/models3d/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/models3d/:path*"
    },
    {
      "source": "/renders/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/renders/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/admin/:path*"
    }
  ]
}
